# Host binding for the only public service.
MODELSURGE_AGENT_BIND=127.0.0.1
MODELSURGE_AGENT_PORT=18099

# Generate different random values for every key before deployment.
MODELSURGE_AGENT_REPLAY_KEY=
MODELSURGE_REPLAY_UPSTREAM_KEY=
MODELSURGE_REPLAY_ADMIN_KEY=
MODELSURGE_UPSTREAM_ADMIN_KEY=

# Optional compatibility bootstrap client key; leave empty for normal deployments.
MODELSURGE_BOOTSTRAP_CLIENT_KEY=

# Optional container timezone.
TZ=UTC
