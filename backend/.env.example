# Copy to .env and replace every value before deployment.
MODELSURGE_SERVICE_KEY=replace-with-random-internal-service-key
MODELSURGE_CLIENT_KEY=replace-with-client-api-key
MODELSURGE_RELAY_ADMIN_KEY=replace-with-relay-admin-key
MODELSURGE_UPSTREAM_ADMIN_KEY=replace-with-upstream-admin-key

# Bind relay to localhost by default. Set 0.0.0.0 only behind a firewall or reverse proxy.
MODELSURGE_BIND_ADDRESS=127.0.0.1
MODELSURGE_RELAY_PORT=18099
